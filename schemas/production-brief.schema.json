{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framecraft:production-brief:1",
  "title": "Framecraft production intent, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "sceneId", "audience", "message", "format", "references", "narrative", "constraints", "design", "audio", "review"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projectId": {"$ref": "#/$defs/id"}, "sceneId": {"$ref": "#/$defs/id"},
    "audience": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"},
    "format": {"enum": ["tech-documentary", "desktop-simulation", "product-explainer", "editorial-graphics", "data-story", "cinematic-type"]},
    "references": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/text"}},
    "narrative": {"$ref": "#/$defs/text"},
    "constraints": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/text"}},
    "design": {
      "type": "object", "additionalProperties": false, "required": ["palette", "typography", "composition", "motion"],
      "properties": {
        "palette": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/text"}},
        "typography": {"$ref": "#/$defs/text"}, "composition": {"$ref": "#/$defs/text"}, "motion": {"$ref": "#/$defs/text"}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false, "required": ["sfx", "silenceReason", "narration", "music"],
      "properties": {
        "sfx": {"enum": ["required", "optional", "silent"]},
        "silenceReason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "narration": {"$ref": "#/$defs/authorization"}, "music": {"$ref": "#/$defs/authorization"}
      },
      "allOf": [{"if": {"properties": {"sfx": {"const": "silent"}}}, "then": {"properties": {"silenceReason": {"$ref": "#/$defs/text"}}}}]
    },
    "review": {"type": "object", "additionalProperties": false, "required": ["humanApprovalRequired"], "properties": {"humanApprovalRequired": {"type": "boolean"}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "\\S"},
    "authorization": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "authorization"],
      "properties": {"enabled": {"type": "boolean"}, "authorization": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}},
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"authorization": {"$ref": "#/$defs/text"}}}}]
    }
  }
}
